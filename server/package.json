{
  "name": "lawtech-server",
  "version": "1.0.0",
  "description": "Backend server for LawTech application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "bot:telegram": "node bots/telegramBots.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:load": "cross-env NODE_ENV=test node __tests__/load/run.js",
    "start:faiss": "cd scripts && python faiss_service.py",
    "db:check": "node scripts/check_database.js",
    "db:reset": "node scripts/reset_database.js",
    "db:migrate": "node scripts/reset_database.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.3.1",
    "node-fetch": "^2.7.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^4.1.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
