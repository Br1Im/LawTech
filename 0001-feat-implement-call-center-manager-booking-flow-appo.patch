+      // Создаём событие в календаре
+      await connection.query(
+        `INSERT INTO calendar_events (title, description, start_date, time, type, priority, office_id, created_by)
+         VALUES (?, ?, ?, ?, 'consultation', 'high', ?, ?)`,
+        [
+          `Приём: ${client_name}`,
+          `Телефон: ${client_phone}\nИсточник: ${lead.source || '—'}\n${comment || ''}`,
+          appointment_date,
+          appointment_time,
+          req.user.office_id,
+          req.user.id
+        ]
+      );
+
+      await connection.commit();
+
+      res.status(201).json({
+        success: true,
+        message: 'Клиент записан на приём',
+        data: {
+          appointment_id: appointmentResult.insertId,
+          client_id: clientId,
+          lead_id: parseInt(id),
+          appointment_date,
+          appointment_time
+        }
+      });
+    } catch (error) {
+      await connection.rollback();
+      console.error('Error booking client:', error);
+      res.status(500).json({ success: false, message: 'Ошибка при записи клиента' });
+    } finally {
+      connection.release();
+    }
+  },
+
+  // ========== Список записей (для менеджера/ОКК) ==========
+  async getAppointments(req, res) {
+    if (!await ensureOfficeAccess(req, res)) return;
+
+    try {
+      const { status, date_from, date_to } = req.query;
+
+      let where = 'a.office_id = ?';
+      const params = [req.user.office_id];
+
+      if (status && status !== 'ALL') {
+        where += ' AND a.status = ?';
+        params.push(status);
+      }
+
+      if (date_from) {
+        where += ' AND a.appointment_date >= ?';
+        params.push(date_from);
+      }
+
+      if (date_to) {
+        where += ' AND a.appointment_date <= ?';
+        params.push(date_to);
+      }
+
+      const [rows] = await db.query(
+        `SELECT
+           a.*,
+           l.source AS lead_source,
+           l.description AS lead_description,
+           l.status AS lead_status,
+           u.first_name AS lawyer_first_name,
+           u.last_name AS lawyer_last_name
+         FROM appointments a
+         LEFT JOIN call_center_leads l ON l.id = a.lead_id
+         LEFT JOIN users u ON u.id = a.assigned_lawyer_id
+         WHERE ${where}
+         ORDER BY a.appointment_date ASC, a.appointment_time ASC`,
+        params
+      );
+
+      res.json({ success: true, data: rows });
+    } catch (error) {
+      console.error('Error getting appointments:', error);
+      res.status(500).json({ success: false, message: 'Ошибка при получении записей' });
+    }
+  },
+
+  // ========== Обновление статуса записи (менеджер/ОКК) ==========
+  async updateAppointment(req, res) {
+    if (!await ensureOfficeAccess(req, res)) return;
+
+    const connection = await db.getClient();
+    try {
+      const { id } = req.params;
+      const { status, manager_comment, assigned_lawyer_id } = req.body;
+
+      const validStatuses = ['waiting', 'arrived', 'no_show', 'cancelled'];
+      if (status && !validStatuses.includes(status)) {
+        return res.status(400).json({ success: false, message: 'Недопустимый статус' });
+      }
+
+      await connection.beginTransaction();
+
+      const [existing] = await connection.query(
+        'SELECT * FROM appointments WHERE id = ? AND office_id = ?',
+        [id, req.user.office_id]
+      );
+
+      if (existing.length === 0) {
+        await connection.rollback();
+        return res.status(404).json({ success: false, message: 'Запись не найдена' });
+      }
+
+      const appointment = existing[0];
+      const updates = [];
+      const params = [];
+
+      if (status) {
+        updates.push('status = ?');
+        params.push(status);
+      }
+      if (manager_comment !== undefined) {
+        updates.push('manager_comment = ?');
+        params.push(manager_comment);
+      }
+      if (assigned_lawyer_id !== undefined) {
+        updates.push('assigned_lawyer_id = ?');
+        params.push(assigned_lawyer_id || null);
+      }
+
+      if (updates.length > 0) {
+        await connection.query(
+          `UPDATE appointments SET ${updates.join(', ')}, updated_at = CURRENT_TIMESTAMP WHERE id = ?`,
+          [...params, id]
+        );
+      }
+
+      // Если статус изменён — обновляем историю лида
+      if (status && status !== appointment.status) {
+        const statusLabels = {
+          waiting: 'Ожидает приёма',
+          arrived: 'Клиент пришёл',
+          no_show: 'Не пришёл',
+          cancelled: 'Отменил'
+        };
+
+        await addHistoryEntry(connection, appointment.lead_id, 'APPOINTMENT_STATUS', req.user.id, {
+          appointment_id: parseInt(id),
+          from: appointment.status,
+          to: status,
+          label: statusLabels[status] || status,
+          comment: manager_comment || null
+        });
+
+        // Если клиент пришёл и назначен юрист — обновляем клиента
+        if (status === 'arrived' && assigned_lawyer_id && appointment.client_id) {
+          await connection.query(
+            `UPDATE clients SET status = 'active', updated_at = CURRENT_TIMESTAMP WHERE id = ?`,
+            [appointment.client_id]
+          );
+        }
+      }
+
+      await connection.commit();
+
+      // Возвращаем обновлённую запись
+      const [updated] = await db.query(
+        `SELECT a.*, l.source AS lead_source, l.description AS lead_description, l.status AS lead_status
+         FROM appointments a
+         LEFT JOIN call_center_leads l ON l.id = a.lead_id
+         WHERE a.id = ?`,
+        [id]
+      );
+
+      res.json({ success: true, data: updated[0] || null });
+    } catch (error) {
+      await connection.rollback();
+      console.error('Error updating appointment:', error);
+      res.status(500).json({ success: false, message: 'Ошибка при обновлении записи' });
+    } finally {
+      connection.release();
+    }
+  },
+
+  // ========== Получение записей по лиду (для начальника КЦ) ==========
+  async getLeadAppointments(req, res) {
+    if (!await ensureOfficeAccess(req, res)) return;
+
+    try {
+      const { id } = req.params;
+      const [rows] = await db.query(
+        `SELECT a.*,
+           CASE a.status
+             WHEN 'waiting' THEN 'Ожидает приёма'
+             WHEN 'arrived' THEN 'Клиент пришёл'
+             WHEN 'no_show' THEN 'Не пришёл'
+             WHEN 'cancelled' THEN 'Отменил'
+           END AS status_label
+         FROM appointments a
+         WHERE a.lead_id = ? AND a.office_id = ?
+         ORDER BY a.created_at DESC`,
+        [id, req.user.office_id]
+      );
+
+      res.json({ success: true, data: rows });
+    } catch (error) {
+      console.error('Error getting lead appointments:', error);
+      res.status(500).json({ success: false, message: 'Ошибка' });
+    }
   }
 };
 
