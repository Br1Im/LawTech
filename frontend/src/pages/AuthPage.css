/* ============================================================
   LawTech - Auth page (продолжение лендинга)
   Гравюрный классический стиль: белый фон, синяя тушь #3A2BE8
   Шрифты: Playfair Display (заголовки) + Inter (текст)
   ============================================================ */

:root {
  --auth-blue: #3A2BE8;
  --auth-blue-deep: #2417C0;
  --auth-ink: #0F1115;
  --auth-ink-soft: #5B5F6B;
  --auth-paper: #FFFFFF;
  --auth-line: rgba(42, 28, 224, .22);
  --auth-line-soft: rgba(15, 17, 21, .10);
  --auth-ease: cubic-bezier(.16, 1, .3, 1);
}

.auth-shell {
  position: relative;
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96px 24px 40px;
  background: #fff;
  overflow: hidden;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: var(--auth-ink);
}

.auth-shell::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(58% 48% at 50% 0%, rgba(58, 43, 232, .05), transparent 70%);
  pointer-events: none;
  opacity: 0;
  animation: auth-glow-in 1.4s var(--auth-ease) .05s forwards;
}
@keyframes auth-glow-in { to { opacity: 1; } }

/* ---------- боковые гравюры ---------- */
.auth-illus {
  position: fixed;
  top: 0;
  bottom: 0;
  width: 32vw;
  max-width: 500px;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  opacity: 0;
}
.auth-illus.left {
  left: 0;
  -webkit-mask-image: linear-gradient(to right, #000 48%, transparent 90%);
  mask-image: linear-gradient(to right, #000 48%, transparent 90%);
  animation: auth-illus-left 1.2s var(--auth-ease) .15s forwards;
}
.auth-illus.right {
  right: 0;
  -webkit-mask-image: linear-gradient(to left, #000 48%, transparent 90%);
  mask-image: linear-gradient(to left, #000 48%, transparent 90%);
  animation: auth-illus-right 1.2s var(--auth-ease) .15s forwards;
}
.auth-illus img {
  height: 100%;
  width: 100%;
  object-fit: cover;
  object-position: center top;
  mix-blend-mode: multiply;
  will-change: transform;
}
.auth-illus.left img  { animation: auth-float-a 16s ease-in-out 1.4s infinite; }
.auth-illus.right img { animation: auth-float-b 18s ease-in-out 1.4s infinite; }
@keyframes auth-illus-left {
  from { opacity: 0; transform: translateX(-42px); filter: blur(9px); }
  to   { opacity: 1; transform: translateX(0);     filter: blur(0); }
}
@keyframes auth-illus-right {
  from { opacity: 0; transform: translateX(42px);  filter: blur(9px); }
  to   { opacity: 1; transform: translateX(0);     filter: blur(0); }
}
@keyframes auth-float-a {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8px); }
}
@keyframes auth-float-b {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(7px); }
}

/* ---------- шапка ---------- */
.auth-top {
  position: absolute;
  top: 30px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 3;
}
.auth-logo {
  text-align: center;
  line-height: 1;
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 600;
  font-size: 20px;
  letter-spacing: .16em;
  color: var(--auth-blue);
  opacity: 0;
  animation: auth-blur-in .8s var(--auth-ease) .05s forwards;
}
.auth-logo small {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 10.5px;
  letter-spacing: .3em;
  color: var(--auth-ink-soft);
  margin-top: 5px;
  font-weight: 500;
}

/* ---------- центральная колонка ---------- */
.auth-center {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 468px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.auth-eyebrow {
  font-size: 12px;
  letter-spacing: .3em;
  text-transform: uppercase;
  color: var(--auth-blue);
  font-weight: 500;
  opacity: 0;
  animation: auth-blur-in .7s var(--auth-ease) .22s forwards;
}
.auth-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 500;
  font-size: clamp(40px, 6vw, 62px);
  line-height: 1.05;
  color: var(--auth-ink);
  margin: 16px 0 0;
  opacity: 0;
  animation: auth-blur-in .85s var(--auth-ease) .3s forwards;
}
.auth-title em {
  font-style: italic;
  color: var(--auth-blue);
}

/* классическая линейка-орнамент */
.auth-rule {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 180px;
  margin: 20px 0 2px;
  opacity: 0;
  transform: scaleX(.2);
  transform-origin: center;
  animation: auth-rule-in .9s var(--auth-ease) .42s forwards;
}
@keyframes auth-rule-in {
  from { opacity: 0; transform: scaleX(.2); }
  to   { opacity: 1; transform: scaleX(1); }
}
.auth-rule::before,
.auth-rule::after {
  content: '';
  height: 1px;
  flex: 1;
  background: linear-gradient(to var(--dir, right), transparent, var(--auth-line));
}
.auth-rule::before { --dir: left; }
.auth-rule span {
  width: 7px;
  height: 7px;
  transform: rotate(45deg);
  border: 1px solid var(--auth-blue);
  flex: 0 0 auto;
  animation: auth-diamond-in .8s var(--auth-ease) .7s both;
}
@keyframes auth-diamond-in {
  from { transform: rotate(-135deg) scale(0); }
  to   { transform: rotate(45deg) scale(1); }
}

.auth-subtitle {
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-size: 19px;
  color: var(--auth-ink-soft);
  margin: 12px 0 0;
  opacity: 0;
  animation: auth-blur-in .8s var(--auth-ease) .5s forwards;
}

@keyframes auth-blur-in {
  from { opacity: 0; transform: translateY(14px); filter: blur(6px); }
  to   { opacity: 1; transform: translateY(0);    filter: blur(0); }
}
@keyframes auth-rise { to { opacity: 1; transform: none; } }

/* ---------- карточка формы ---------- */
.auth-card {
  width: 100%;
  margin-top: 32px;
  background: #fff;
  border: 1px solid var(--auth-line-soft);
  border-radius: 20px;
  padding: 36px 36px 30px;
  box-shadow: 0 30px 70px -46px rgba(42, 28, 224, .38);
  text-align: left;
  opacity: 0;
  animation: auth-card-in .9s var(--auth-ease) .58s forwards;
  transition: box-shadow .45s var(--auth-ease), transform .45s var(--auth-ease);
}
@keyframes auth-card-in {
  from { opacity: 0; transform: translateY(26px) scale(.985); filter: blur(5px); }
  to   { opacity: 1; transform: translateY(0) scale(1);       filter: blur(0); }
}
.auth-card:hover { box-shadow: 0 40px 90px -46px rgba(42, 28, 224, .5); }

/* стаггер полей внутри формы */
.auth-card .ant-form > *,
.auth-card > div > * {
  opacity: 0;
  animation: auth-field-in .6s var(--auth-ease) forwards;
}
@keyframes auth-field-in {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
.auth-card .ant-form > *:nth-child(1), .auth-card > div > *:nth-child(1) { animation-delay: .78s; }
.auth-card .ant-form > *:nth-child(2), .auth-card > div > *:nth-child(2) { animation-delay: .86s; }
.auth-card .ant-form > *:nth-child(3), .auth-card > div > *:nth-child(3) { animation-delay: .94s; }
.auth-card .ant-form > *:nth-child(4), .auth-card > div > *:nth-child(4) { animation-delay: 1.02s; }
.auth-card .ant-form > *:nth-child(5), .auth-card > div > *:nth-child(5) { animation-delay: 1.10s; }
.auth-card .ant-form > *:nth-child(6), .auth-card > div > *:nth-child(6) { animation-delay: 1.18s; }
.auth-card .ant-form > *:nth-child(7), .auth-card > div > *:nth-child(7) { animation-delay: 1.26s; }
.auth-card .ant-form > *:nth-child(8), .auth-card > div > *:nth-child(8) { animation-delay: 1.34s; }

.auth-field { margin-bottom: 20px; }
.auth-field:last-of-type { margin-bottom: 10px; }
.auth-label {
  display: block;
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--auth-ink-soft);
  margin-bottom: 6px;
  transition: color .3s var(--auth-ease);
}
.auth-field:focus-within .auth-label { color: var(--auth-blue); }

/* ---------- поля: подчёркнутый (гравюрный) стиль ---------- */
.auth-card .ant-input,
.auth-card .ant-input-affix-wrapper {
  border-radius: 0 !important;
  padding: 8px 2px !important;
  border: 0 !important;
  border-bottom: 1.5px solid var(--auth-line) !important;
  background-color: transparent !important;
  background-image: linear-gradient(var(--auth-blue), var(--auth-blue)) !important;
  background-repeat: no-repeat !important;
  background-position: 0 100% !important;
  background-size: 0 2px !important;
  font-size: 16px !important;
  color: var(--auth-ink) !important;
  box-shadow: none !important;
  transition: background-size .45s var(--auth-ease), border-color .3s var(--auth-ease) !important;
}
.auth-card .ant-input-affix-wrapper .ant-input {
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
  background-image: none !important;
  font-size: 16px !important;
}
.auth-card .ant-input::placeholder { color: rgba(91, 95, 107, .55); }
.auth-card .ant-input:focus,
.auth-card .ant-input-affix-wrapper-focused,
.auth-card .ant-input-affix-wrapper:focus,
.auth-card .ant-input-affix-wrapper:focus-within {
  border-bottom-color: var(--auth-blue) !important;
  background-size: 100% 2px !important;
  box-shadow: none !important;
}
.auth-card .ant-input:hover,
.auth-card .ant-input-affix-wrapper:hover {
  border-bottom-color: var(--auth-blue) !important;
  background: transparent !important;
  background-image: linear-gradient(var(--auth-blue), var(--auth-blue)) !important;
  box-shadow: none !important;
}
.auth-card .ant-input-status-error,
.auth-card .ant-input-affix-wrapper-status-error {
  border-bottom-color: #dc2626 !important;
}

/* ---------- пилюли выбора роли ---------- */
.auth-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.auth-pill {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: var(--auth-ink-soft);
  background: #fff;
  border: 1px solid var(--auth-line);
  border-radius: 100px;
  padding: 8px 15px;
  cursor: pointer;
  transition: transform .25s var(--auth-ease), color .25s var(--auth-ease), border-color .25s var(--auth-ease), background .25s var(--auth-ease), box-shadow .25s var(--auth-ease);
}
.auth-pill:hover {
  border-color: var(--auth-blue);
  color: var(--auth-blue);
  transform: translateY(-1px);
}
.auth-pill:active { transform: translateY(0) scale(.97); }
.auth-pill.active {
  background: var(--auth-blue);
  border-color: var(--auth-blue);
  color: #fff;
  box-shadow: 0 8px 20px -10px rgba(58, 43, 232, .7);
  animation: auth-pill-pop .35s var(--auth-ease);
}
@keyframes auth-pill-pop {
  0%   { transform: scale(.9); }
  55%  { transform: scale(1.06); }
  100% { transform: scale(1); }
}
.auth-pill-error {
  margin-top: 7px;
  font-size: 12.5px;
  color: #dc2626;
}

.auth-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 8px 0 22px;
  font-size: 14px;
}
.auth-remember {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: var(--auth-ink-soft);
  cursor: pointer;
  user-select: none;
}
.auth-remember input {
  width: 17px;
  height: 17px;
  accent-color: var(--auth-blue);
  cursor: pointer;
}
.auth-forgot {
  color: var(--auth-blue);
  font-weight: 500;
  background: none;
  border: 0;
  cursor: pointer;
  padding: 0;
  font-size: 14px;
  transition: color .3s;
}
.auth-forgot:hover { color: var(--auth-blue-deep); text-decoration: underline; }

.auth-card .auth-submit,
.auth-card .auth-submit.ant-btn {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 52px;
  margin-top: 8px;
  border-radius: 100px;
  background: var(--auth-blue);
  border: 1px solid var(--auth-blue);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: .02em;
  transition: transform .3s var(--auth-ease), box-shadow .3s var(--auth-ease), background .3s;
  box-shadow: 0 14px 30px -14px rgba(58, 43, 232, .6);
}
.auth-card .auth-submit::after {
  content: '';
  position: absolute;
  top: 0;
  left: -160%;
  width: 55%;
  height: 100%;
  background: linear-gradient(120deg, transparent, rgba(255, 255, 255, .38), transparent);
  transform: skewX(-20deg);
  pointer-events: none;
  animation: auth-sheen 1.1s var(--auth-ease) 1.5s 1 both;
}
@keyframes auth-sheen {
  from { left: -160%; }
  to   { left: 170%; }
}
.auth-card .auth-submit:hover,
.auth-card .auth-submit.ant-btn:hover {
  background: var(--auth-blue-deep) !important;
  border-color: var(--auth-blue-deep) !important;
  color: #fff !important;
  transform: translateY(-2px) scale(1.01);
  box-shadow: 0 20px 40px -14px rgba(58, 43, 232, .7);
}
.auth-card .auth-submit:hover::after {
  animation: auth-sheen .7s var(--auth-ease) 1;
}
.auth-card .auth-submit:active { transform: translateY(0) scale(.995); }

.auth-switch {
  margin-top: 20px;
  text-align: center;
  font-size: 13.5px;
  color: var(--auth-ink-soft);
}
.auth-switch button {
  background: none;
  border: 0;
  color: var(--auth-blue);
  font-weight: 600;
  cursor: pointer;
  padding: 0 0 0 5px;
  font-size: 13.5px;
}
.auth-switch button:hover { text-decoration: underline; }

.auth-foot {
  position: relative;
  z-index: 2;
  margin-top: 40px;
  text-align: center;
  max-width: 440px;
  opacity: 0;
  animation: auth-blur-in .9s var(--auth-ease) 1.15s forwards;
}
.auth-foot .safe {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: var(--auth-ink);
  font-size: 14px;
  font-weight: 500;
}
.auth-foot .safe svg { width: 16px; height: 16px; color: var(--auth-blue); }
.auth-foot .safe-sub {
  margin-top: 8px;
  color: var(--auth-ink-soft);
  font-size: 13px;
  line-height: 1.5;
}
.auth-foot .brand-bottom {
  margin-top: 22px;
  font-family: 'Playfair Display', Georgia, serif;
  letter-spacing: .16em;
  color: var(--auth-blue);
  font-weight: 600;
  font-size: 14px;
}

.auth-verify-code .ant-input {
  text-align: center;
  letter-spacing: .4em;
  font-size: 26px !important;
  font-weight: 700;
}
.auth-verify-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16px;
  font-size: 14px;
}
.auth-verify-actions button {
  background: none; border: 0; color: var(--auth-blue);
  cursor: pointer; padding: 0; font-size: 14px;
}
.auth-verify-actions button:disabled { color: var(--auth-ink-soft); cursor: default; }

/* ---------- адаптив ---------- */
@media (max-width: 1024px) {
  .auth-illus.left  { animation: auth-illus-left-dim 1.1s var(--auth-ease) .15s forwards; }
  .auth-illus.right { animation: auth-illus-right-dim 1.1s var(--auth-ease) .15s forwards; }
  @keyframes auth-illus-left-dim  { from { opacity: 0; transform: translateX(-30px); } to { opacity: .82; transform: none; } }
  @keyframes auth-illus-right-dim { from { opacity: 0; transform: translateX(30px); }  to { opacity: .82; transform: none; } }
}
@media (max-width: 720px) {
  .auth-illus { position: absolute; width: 60vw; }
  .auth-illus.left, .auth-illus.right { animation: auth-illus-bg 1s var(--auth-ease) .15s forwards; }
  @keyframes auth-illus-bg { to { opacity: .1; } }
  .auth-shell { padding: 88px 18px 32px; }
  .auth-card { padding: 28px 22px 24px; border-radius: 16px; }
}
@media (max-width: 380px) {
  .auth-illus { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .auth-illus, .auth-illus img, .auth-illus.left, .auth-illus.right,
  .auth-eyebrow, .auth-title, .auth-rule, .auth-rule span, .auth-subtitle,
  .auth-card, .auth-card .ant-form > *, .auth-card > div > *,
  .auth-logo, .auth-foot, .auth-shell::before, .auth-pill.active,
  .auth-card .auth-submit::after {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
  }
}
