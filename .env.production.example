# 🔐 Пример файла переменных окружения для продакшена
# Скопируйте этот файл в .env.production и измените значения

# ========================================
# BACKEND (.env в папке server/)
# ========================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_USER=lawtech_user
DB_PASSWORD=your_strong_password_here_change_me
DB_NAME=lawtech_crm
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://217.26.31.98,http://your-domain.com

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# FAISS Service
FAISS_SERVICE_URL=http://localhost:5000

# ========================================
# FRONTEND (.env.production в папке frontend/)
# ========================================

# API URL
VITE_API_URL=http://217.26.31.98:3001/api

# Или если используете домен:
# VITE_API_URL=https://your-domain.com/api

# ========================================
# DOCKER COMPOSE (если используете Docker)
# ========================================

# MySQL
MYSQL_ROOT_PASSWORD=lawtech_root_password_2024_change_me
MYSQL_DATABASE=lawtech_crm
MYSQL_USER=lawtech_user
MYSQL_PASSWORD=lawtech_password_2024_change_me

# ========================================
# ВАЖНО! 
# ========================================
# 1. Измените все пароли и секретные ключи
# 2. Не коммитьте файлы .env в Git
# 3. Используйте сильные пароли (минимум 16 символов)
# 4. Для генерации JWT_SECRET используйте: openssl rand -base64 32
