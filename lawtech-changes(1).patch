+.lawyers-legend .legend-item { display: inline-flex; align-items: center; gap: 4px; }
+.lawyers-legend svg { color: #d4af37; font-size: 11px; }
+
+.lawyers-table tbody tr.lawyer-row { cursor: pointer; transition: background-color .15s ease; }
+.lawyers-table tbody tr.lawyer-row:hover td { background: rgba(212,175,55,0.10); }
+.lawyers-table th.num, .lawyers-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
+
+.lawyer-rating-stars { display: inline-flex; gap: 2px; vertical-align: middle; }
+.lawyer-rating-stars svg { color: #d4af37; font-size: 14px; }
+
+.rating-badge {
+  margin-left: 8px; padding: 2px 8px; border-radius: 999px;
+  font-size: 11px; font-weight: 600; vertical-align: middle;
+}
+.rating-badge.rating-3 { background: rgba(40,160,80,0.12); color: #1f7a3a; border: 1px solid rgba(40,160,80,0.3); }
+.rating-badge.rating-2 { background: rgba(212,175,55,0.15); color: #8a6b1d; border: 1px solid rgba(212,175,55,0.4); }
+.rating-badge.rating-1 { background: rgba(160,120,40,0.10); color: #8a6b1d; border: 1px solid rgba(160,120,40,0.25); }
+.rating-badge.rating-0 { background: rgba(180,180,180,0.15); color: #6b6b6b; border: 1px solid rgba(160,160,160,0.3); }
+
+.lawyer-modal { max-width: 720px; }
+.lawyer-rating-row {
+  display: flex; align-items: center; gap: 10px; margin: 4px 0 14px;
+}
+.lawyer-rating-row .lawyer-rating-stars svg { font-size: 18px; }
+
+.lawyer-summary {
+  display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
+  margin: 8px 0 18px;
+}
+.lawyer-summary-cell {
+  background: linear-gradient(180deg, rgba(212,175,55,0.06), transparent);
+  border: 1px solid rgba(212,175,55,0.20);
+  border-radius: 10px; padding: 12px 14px;
+}
+.lawyer-summary-cell .cell-label {
+  font-size: 11px; color: var(--color-text-muted, #8a7a5a);
+  text-transform: uppercase; letter-spacing: 0.5px;
+}
+.lawyer-summary-cell .cell-value {
+  font-size: 20px; font-weight: 700; color: var(--color-text);
+  font-variant-numeric: tabular-nums; margin-top: 4px;
+}
+.lawyer-topics-table th.num, .lawyer-topics-table td.num {
+  text-align: right; font-variant-numeric: tabular-nums;
+}
+.muted { color: var(--color-text-muted, #8a7a5a); font-size: 13px; }
+
+/* === Plan / Fact widgets === */
+.plan-fact-block {
+  background: var(--glass-bg, rgba(255,255,255,0.7));
+  border: 1px solid var(--glass-border, rgba(0,0,0,0.06));
+  border-radius: 16px; padding: 16px; box-shadow: 0 6px 18px rgba(17,17,17,0.04);
+}
+.plan-fact-header {
+  display: flex; align-items: center; justify-content: space-between; gap: 12px;
+  margin-bottom: 12px;
+}
+.plan-edit-btn {
+  display: inline-flex; align-items: center; gap: 6px;
+  padding: 7px 12px; border-radius: 8px; cursor: pointer;
+  background: rgba(212,175,55,0.10); border: 1px solid rgba(212,175,55,0.35);
+  color: #8a6b1d; font-weight: 600; font-size: 13px;
+  transition: background-color .15s ease, border-color .15s ease;
+}
+.plan-edit-btn:hover { background: rgba(212,175,55,0.18); }
+.plan-fact-grid {
+  display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;
+}
+.plan-fact-card {
+  border-radius: 12px; padding: 12px 14px;
+  border: 1px solid rgba(0,0,0,0.06);
+  background: linear-gradient(180deg, rgba(255,255,255,0.6), rgba(255,255,255,0.2));
+}
+.plan-fact-card.plan-good { border-color: rgba(40,160,80,0.35); background: linear-gradient(180deg, rgba(40,160,80,0.10), rgba(40,160,80,0.02)); }
+.plan-fact-card.plan-warn { border-color: rgba(212,175,55,0.45); background: linear-gradient(180deg, rgba(212,175,55,0.12), rgba(212,175,55,0.02)); }
+.plan-fact-card.plan-bad  { border-color: rgba(212,73,58,0.40);  background: linear-gradient(180deg, rgba(212,73,58,0.10), rgba(212,73,58,0.02)); }
+.plan-fact-card.plan-empty { border-style: dashed; }
+
+.plan-fact-label {
+  font-size: 12px; color: var(--color-text-muted, #8a7a5a);
