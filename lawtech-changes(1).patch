+.plan-fact-label .period-range { text-transform: none; opacity: 0.8; font-size: 11px; }
+.plan-fact-label .plan-day-kind { text-transform: none; opacity: 0.85; font-size: 11px; margin-left: 4px; color: var(--color-accent, #b8941f); }
+.plan-fact-value {
+  display: inline-flex; align-items: baseline; gap: 6px; margin: 6px 0 8px;
