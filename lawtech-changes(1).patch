+        return bad(res, 403, 'Чужой офис');
+      }
+    }
+    try {
+      await db.query(
+        `INSERT INTO shifts (office_id, employee_id, shift_date, note, created_by) VALUES (?, ?, ?, ?, ?)`,
+        [officeId, Number(employee_id), shift_date, note || null, req.user.id || null]
