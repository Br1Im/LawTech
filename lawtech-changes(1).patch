+/* =============================================
+   OFFICE PAGE — VISUAL POLISH OVERRIDES
+   Loaded after OfficeContent.css to cleanly
+   improve the visuals of the "Офис" tab.
+   ============================================= */
+
+/* Hide the awkward "arrow in the middle" expand button that sat
+   between the two stat cards — the cards themselves are clickable. */
+.office-left-column .expand-button-container {
+  display: none;
+}
+
+/* Make the other floating expand arrows less loud. They're hints
+   for "view details", not primary actions. */
+.office-content .expand-button {
+  width: 26px;
+  height: 26px;
+  background: transparent;
+  color: var(--color-accent);
+  border: 1px solid var(--color-accent);
+  box-shadow: none;
+  opacity: 0.55;
+  font-size: 10px;
+  top: 10px;
+  right: 10px;
+}
+.office-content .expand-button:hover {
+  transform: translateX(2px);
+  background: var(--color-accent);
+  color: #fff;
+  opacity: 1;
+}
+
+/* Header: gentle gold gradient accent on the left edge */
+.office-header {
+  position: relative;
+  overflow: hidden;
+}
+.office-header::before {
+  content: '';
+  position: absolute;
+  inset: 0 auto 0 0;
+  width: 4px;
+  background: linear-gradient(180deg, var(--color-accent), var(--color-accent-dark, #a88436));
+  border-radius: 4px 0 0 4px;
+}
+
+/* Office card: tidy spacing and cleaner selected state */
+.office-card {
+  padding: 18px 18px 16px;
+  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
+}
+.office-card:hover {
+  transform: none;
+  box-shadow: 0 4px 16px rgba(0,0,0,0.06);
+}
+.office-card.selected {
+  background: linear-gradient(180deg, var(--color-accent-light) 0%, transparent 140%);
+  box-shadow: 0 6px 18px rgba(191,149,63,0.12);
+}
+.office-card-header h3 {
+  font-size: 15px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  color: var(--color-text);
+}
+.office-card.selected .office-card-header h3 {
+  color: var(--color-accent);
+}
+.office-card-info p {
+  margin: 6px 0;
+}
+
+/* Stat card refinements */
+.stat-card {
+  padding: 20px 22px;
+  border-radius: 16px;
+}
+.stat-card-title {
+  font-size: 12px;
+  letter-spacing: 0.08em;
+  margin-bottom: 14px;
+}
+.stat-card-value {
+  font-size: 28px;
+  line-height: 1.1;
+  font-variant-numeric: tabular-nums;
+}
+.stat-card-percentage {
+  margin-top: 10px;
+  font-size: 13px;
+  font-weight: 500;
+}
+.stat-card-percentage .description {
+  font-size: 12px;
+  margin-top: 2px;
+  color: var(--color-text-secondary);
+  opacity: 0.85;
+}
+
+/* Employee table: calmer zebra stripes, right-align money columns */
+.employee-stats-table thead {
+  background: linear-gradient(180deg, var(--color-accent), var(--color-accent-dark, #a88436));
+}
+.employee-stats-table th:nth-child(2),
+.employee-stats-table th:nth-child(3),
+.employee-stats-table td:nth-child(2),
+.employee-stats-table td:nth-child(3) {
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+.employee-stats-table tbody tr:nth-child(odd) {
+  background: var(--color-bg);
+}
+.employee-stats-table tbody tr:nth-child(even) {
+  background: var(--color-bg-alt);
+}
+.employee-stats-table tbody tr:hover td {
+  background: var(--color-accent-light);
+}
+
+/* Chart cards feel less boxed-in */
+.chart-box-container,
+.charts-container {
+  box-shadow: 0 8px 28px rgba(17,17,17,0.05);
+}
+
+/* Section titles: subtle gold underline accent */
+.section-title {
+  position: relative;
+  padding-bottom: 6px;
+}
+.section-title::after {
+  content: '';
+  position: absolute;
+  left: 0;
+  bottom: 0;
+  width: 28px;
+  height: 2px;
+  background: var(--color-accent);
+  border-radius: 2px;
+}
+
+/* Period dropdown: a touch more polish */
+.period-dropdown-header {
