+.plan-fact-pct {
+  margin-top: 6px; font-size: 12px; color: var(--color-text-muted, #8a7a5a);
+}
+
+/* === Касса юристов === */
+.lawyers-cash-table .num.strong { font-weight: 700; color: var(--color-text); }
