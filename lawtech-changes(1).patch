+.plan-fact-value .plan { font-size: 16px; opacity: 0.75; }
+.plan-fact-progress {
+  height: 6px; background: rgba(0,0,0,0.08); border-radius: 4px; overflow: hidden;
+}
+.plan-fact-bar { height: 100%; transition: width .3s ease; background: #d4af37; }
