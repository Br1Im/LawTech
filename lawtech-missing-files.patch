+  description?: string | null;
+  client_name?: string | null;
+  client_phone?: string | null;
+  client_email?: string | null;
+  employee_name?: string | null;
+  // New fields for type 1 / type 2 split
+  contract_type?: 'docs' | 'court_rep' | string | null;
