FROM python:3.12-slim

WORKDIR /app

# Установка системных зависимостей
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Клонирование и установка Perspectra
RUN git clone https://github.com/ad-si/Perspectra.git /app && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Рабочая директория для обработки файлов
WORKDIR /work

# Точка входа
ENTRYPOINT ["python", "-m", "perspectra"]
CMD ["--help"]
